# Создание списка гостей
guests = ["Анна", "Иван", "Мария"]

# Вывод пригласительного сообщения каждому гостю
for guest in guests:
    print(f"Дорогой(ая) {guest}, приглашаю вас на ужин!")

print("\n--- Изменения в списке гостей ---\n")

# Вывод имени гостя, который не сможет прийти
guest_cant_come = "Иван"
print(f"К сожалению, {guest_cant_come} не сможет прийти на ужин.")

# Замена гостя, который не сможет прийти, новым именем
new_guest = "Петр"

# Находим индекс гостя, который не сможет прийти
index = guests.index(guest_cant_come)

# Заменяем гостя в списке
guests[index] = new_guest

print(f"Вместо него приглашаем {new_guest}.\n")

# Вывод нового набора приглашений для каждого участника
print("--- Новый список приглашений ---")
for guest in guests:
    print(f"Дорогой(ая) {guest}, приглашаю вас на ужин!")

    print("\n--- Хорошие новости! ---\n")

# Сообщение о найденном большем столе
print("Отличные новости! Мы нашли стол большего размера, поэтому можем пригласить еще трех гостей!\n")

# Добавление гостя в начало списка
guests.insert(0, "Елена")
print(f"Добавлен(а) в начало списка: {guests[0]}")

# Добавление гостя в середину списка
middle_index = len(guests) // 2
guests.insert(middle_index, "Дмитрий") 
print(f"Добавлен(а) в середину списка: {guests[middle_index]}")

# Добавление гостя в конец списка
guests.append("Ольга")
print(f"Добавлен(а) в конец списка: {guests[-1]}")

print("\n--- Полный список приглашений ---\n")

# Вывод полного списка приглашений
for guest in guests:
    print(f"Дорогой(ая) {guest}, приглашаю вас на ужин!")

# Сообщение о изменении списка приглашенных гостей
print("Приношу свои извенения, обеденный сиол привезти не успевают и на праздник приглашаются двое гостей ")

# Удаление гостей из списка, пока не останутся двое
while len(guests) > 2:
    removed_guest = guests.pop()
    print(f"Мне очень жаль, {removed_guest}, но я вынужден(а) отменить ваше приглашение на ужин.")

print("\n--- Финальный список приглашенных гостей ---\n")

# Вывод приглашений для оставшихся двух гостей
for guest in guests:
    print(f"Дорогой(ая) {guest}, вы все еще приглашены на ужин!")

# Вывод финального списка гостей
print(f"\nФинальный список гостей: {guests}")

print("\n--- Очистка списка гостей ---\n")

# Удаление двух последних гостей с помощью оператора del
if len(guests) >= 2:
    del guests[-1]  # Удаляем последнего гостя
    print("Удален последний гость из списка.")
    del guests[-1]  # Удаляем второго гостя (который теперь последний)
    print("Удален второй гость из списка.")
elif len(guests) == 1:
    del guests[-1]
    print("Удален единственный оставшийся гость из списка.")

print(f"\nФинальный список гостей: {guests}")
print(f"Список пуст: {len(guests) == 0}")